DirectoryIndex index.html

<IfModule mod_headers.c>
    # El HTML debe revalidarse siempre para recibir la versión actual del frontend.
    <FilesMatch "\.html$">
        Header always set Cache-Control "no-cache, no-store, must-revalidate"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </FilesMatch>

    # Los assets generados por Vite llevan hash y pueden cachearse por largo tiempo.
    SetEnvIf Request_URI "^/assets/" clicmenu_vite_asset=1
    Header always set Cache-Control "public, max-age=31536000, immutable" env=clicmenu_vite_asset
</IfModule>

RewriteEngine On

# Servir internamente el HTML prerenderizado de una ruta limpia.
# Ejemplo:
# /blog/mi-publicacion
# -> /blog/mi-publicacion/index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# Respetar archivos y directorios físicos existentes.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Fallback de React para las rutas que no tienen HTML físico.
RewriteRule ^ index.html [L]